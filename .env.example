# Шаблон. Реальные локальные overrides кладут в .env.local / .env.development.local /
# .env.production.local — они уже перечислены в .gitignore.
#
# Vue CLI пробрасывает в бандл ТОЛЬКО переменные с префиксом VUE_APP_
# (плюс NODE_ENV и BASE_URL). Подстановка происходит при сборке, поэтому
# смена адреса требует пересборки dist — перезапуск nginx не поможет.
#
# Слэш в конце обязателен: в SystemActions.ts запрос = API_URL + 'getUserInfo'.

# --- прод (лежит в .env.production, закоммичен) ---
VUE_APP_API_URL=https://api.dictionary.total-black.ru/api/

# --- тест переезда: фронт собирается на адрес новой машины ---
#VUE_APP_API_URL=https://api.new-dictionary.total-black.ru/api/

# --- локальный бэкенд (Nest всегда слушает 4001, PORT из pm2/окружения кодом не читается) ---
#VUE_APP_API_URL=http://127.0.0.1:4001/api/

# --- бэкенд на другой машине в локальной сети ---
#VUE_APP_API_URL=http://192.168.0.155:4001/api/
